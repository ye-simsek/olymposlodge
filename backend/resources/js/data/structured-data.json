    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is breakfast included at Olympos Lodge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, an open-format breakfast featuring organic free-range eggs is included for all guests, served daily from 08:00 to 12:00."
          }
        },
        {
          "@type": "Question",
          "name": "How far is Olympos Lodge from Antalya Airport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Olympos Lodge is approximately 90 km from Antalya Airport, about 90 minutes by car. A private transfer service is available for €100."
          }
        },
        {
          "@type": "Question",
          "name": "Is the beach directly accessible from Olympos Lodge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Olympos Lodge has direct access to Çıralı beach. A sun lounger, umbrella, beach towel, and cabana are included for all guests."
          }
        },
        {
          "@type": "Question",
          "name": "Is the spa included in the room rate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the jacuzzi (6-person capacity), sauna, and steam room are included for all guests. Massage treatments are available at extra cost and require 2-hour advance booking."
          }
        },
        {
          "@type": "Question",
          "name": "How many rooms does Olympos Lodge have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Olympos Lodge has 17 rooms across 4 categories: Super Deluxe (105 m²), Deluxe (70 m²), Göl Evi (60 m²), and Standart Oda (35 m²). All rooms are ground floor with private terraces."
          }
        },
        {
          "@type": "Question",
          "name": "Is parking available at Olympos Lodge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, free on-site parking is available for all guests."
          }
        }
      ]
    }
